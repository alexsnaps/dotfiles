// Niri config ported from ~/.config/hypr/hyprland.conf
// https://niri-wm.github.io/niri/Configuration:-Introduction
//
// Not portable from Hyprland (niri doesn't support these):
// - blur (decoration:blur, noctalia layerrule blur)
// - tearing / immediate window rules for games
// - per-device input config (logitech-g903-ls-1 sensitivity)
// - resize submap (approximated with Mod+Minus/Equal and preset widths)

input {
    keyboard {
        xkb {
            layout "us"
            options "compose:menu"
        }
        numlock
    }

    touchpad {
        // tap-to-click disabled, clickfinger behavior (matches Hyprland touchpad config)
        natural-scroll
        click-method "clickfinger"
    }

    mouse {
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
    }

    // Hyprland gesture: 3-finger horizontal workspace swipe.
    // Niri has built-in 3-finger workspace / column swipes; nothing to configure.
}

// Monitors (from hyprland.conf monitor= lines)
output "eDP-1" {
    mode "2880x1800@120"
    scale 1.5
}

output "DP-1" {
    mode "5120x2160@59.985"
    scale 1.5
}

output "DP-3" {
    mode "5120x2160@59.985"
    // scale auto (omitted)
}

environment {
    LIBVA_DRIVER_NAME "nvidia"
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"

    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "qt6ct"
    GTK_IM_MODULE "simple"

    XCURSOR_SIZE "24"
}

cursor {
    xcursor-size 24
    // Hyprland cursor:inactive_timeout = 3
    hide-after-inactive-ms 3000
}

layout {
    // Hyprland: gaps_in 5, gaps_out 10 → inner gaps 5 + 5px struts on every edge
    gaps 5

    struts {
        left 5
        right 5
        top 5
        bottom 5
    }

    center-focused-column "never"

    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Hyprland used a 2px gradient border; use border instead of focus ring.
    focus-ring {
        off
    }

    border {
        width 2
        // col.active_border = rgba(86e1fcee) rgba(3e68d7ee) 45deg
        active-gradient from="#86e1fcee" to="#3e68d7ee" angle=45
        // col.inactive_border = rgba(545c7eaa)
        inactive-color "#545c7eaa"
    }

    // decoration:shadow (range 4, color rgba(1a1a1aee))
    shadow {
        on
        softness 10
        spread 2
        offset x=0 y=2
        color "#1a1a1aee"
    }
}

// Autostart (from exec-once). Portal/dbus env setup is handled by the niri session itself.
spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-sh-at-startup "~/.cargo/bin/xremap --device \"Keyboardio Atreus\" ~/.config/xremap/atreus.yml --watch"
spawn-at-startup "protonmail-bridge" "--no-window" "--software-renderer"
spawn-at-startup "openrgb" "--startminimized"
// Wallpaper (hyprpaper is Hyprland-only; -m fill matches hyprpaper's cover fit_mode)
spawn-at-startup "swaybg" "-i" "/home/alxs/Pictures/Wallpapers/cyberpunk.jpg" "-m" "fill"

hotkey-overlay {
    skip-at-startup
}

// Needed for niri to know window corners, so rounded corners + borders render cleanly
// (Hyprland decoration:rounding = 20).
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Niri's defaults are close in spirit to the Hyprland easeOutQuint set.
}

// Rounded corners for all windows (Hyprland rounding = 20)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Hyprland inactive_opacity = 0.75
window-rule {
    match is-active=false
    opacity 0.75
}

// windowrule opacity overrides (active is 1.0 in all of them, so only inactive matters)
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"# is-active=false
    opacity 0.5
}

window-rule {
    match app-id=r#"^org\.mozilla\.firefox$"# is-active=false
    opacity 0.6
}

window-rule {
    match title=".*YouTube.*" is-active=false
    opacity 0.9
}

window-rule {
    match app-id=r#"^org\.mozilla\.firefox$"# title="^Prime Video:.*"
    opacity 1.0
}

// Firefox picture-in-picture floats
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="^Rofi$"
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Programs ($terminal, $fileManager, $menu, $ipc from hyprland.conf)
    Mod+Return hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }
    Mod+E hotkey-overlay-title="File browser: rofi" { spawn "rofi" "-show" "filebrowser"; }
    Mod+Escape hotkey-overlay-title="Launcher: noctalia" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Alt+S hotkey-overlay-title="Control center: noctalia" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+Alt+Q hotkey-overlay-title="Session menu: noctalia" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    Mod+Alt+Z hotkey-overlay-title="Lock screen: hyprlock" { spawn "hyprlock"; }

    Mod+Alt+C repeat=false { close-window; }
    Mod+Shift+Alt+Q { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+Ctrl+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }

    Mod+O repeat=false { toggle-overview; }

    // Focus movement (Mod + arrows / hjkl)
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Swap/move windows (Mod+Shift + hjkl, like Hyprland swapwindow)
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // Monitors
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Workspace prev/next (Hyprland Mod+Alt+h/j = e-1, Mod+Alt+l/k = e+1)
    Mod+Alt+H { focus-workspace-up; }
    Mod+Alt+J { focus-workspace-up; }
    Mod+Alt+L { focus-workspace-down; }
    Mod+Alt+K { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }

    // Workspaces by number (Mod+[0-9])
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // Move window to workspace (Mod+Shift+[0-9], like Hyprland movetoworkspace)
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Scroll through workspaces with Mod+wheel (Hyprland mouse_down/mouse_up)
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }

    // Column/window management (niri-specific, no Hyprland equivalent)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+C { center-column; }

    // Resizing (replaces the Hyprland Mod+Alt+R resize submap)
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+F { expand-column-to-available-width; }

    // Volume / media / brightness (allow-when-locked so they work on the lock screen)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "s" "10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "s" "10%-"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}
